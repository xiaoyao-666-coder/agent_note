---
import { getCollection } from "astro:content";
import PostPreview from "@/components/blog/PostPreview.astro";
import {
	categoryPath,
	contentPath,
	getAllNotes,
	getAllPosts,
	getPostsInSeries,
	getSeriesWithCount,
	getUniqueCategoriesWithCount,
	getUniqueTagsWithCount,
	seriesPath,
} from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

const allPosts = await getAllPosts();
const allNotes = (await getAllNotes()).sort(collectionDateSort);
const allContent = [...allPosts, ...allNotes];
const categoryMeta = await getCollection("category");
const seriesMeta = await getCollection("series");

const categoryRows = getUniqueCategoriesWithCount(allContent)
	.map(([id, count]) => {
		const meta = categoryMeta.find((entry) => entry.id === id);
		return {
			id,
			title: meta?.data.title ?? id,
			description: meta?.data.description ?? "",
			count,
			order: meta?.data.order ?? 99,
		};
	})
	.sort((a, b) => a.order - b.order || a.title.localeCompare(b.title, "zh-CN"));

const seriesRows = getSeriesWithCount(allContent)
	.map(([id, count]) => {
		const meta = seriesMeta.find((entry) => entry.id === id);
		return {
			id,
			title: meta?.data.title ?? id,
			description: meta?.data.description ?? "",
			count,
			order: meta?.data.order ?? 99,
			posts: getPostsInSeries(id, allContent),
		};
	})
	.sort((a, b) => a.order - b.order || a.title.localeCompare(b.title, "zh-CN"));

const sortedPosts = [...allPosts].sort(collectionDateSort);
const standaloneNotes = allNotes.filter((note) => !note.data.series);
const popularTags = getUniqueTagsWithCount(allContent).slice(0, 20);

const meta = {
	title: "知识索引",
	description: "按阅读路径、主题分类、文章、学习笔记与标签浏览逍遥哥的知识库。",
};
---

<PageLayout meta={meta}>
	<section class="hero-panel relative z-0">
		<div class="section-label">Knowledge Index</div>
		<h1 class="title relative z-[1] text-2xl sm:text-3xl">知识索引</h1>
		<p class="relative z-[1] mt-3 max-w-3xl leading-relaxed text-[var(--color-muted)]">
			这里是知识库的统一入口：系列、分类和标签同时收录文章与笔记。按系列连续学习，按主题查找内容，也可以直接浏览文章和独立笔记。
		</p>
		<nav aria-label="知识索引页内导航" class="relative z-[1] mt-5 flex flex-wrap gap-2">
			<a class="chip chip-accent" href="#learning-paths">阅读路径</a>
			<a class="chip" href="#categories">主题分类</a>
			<a class="chip" href="#standalone">文章</a>
			<a class="chip" href="#notes">独立笔记</a>
			<a class="chip" href="#tags">热门标签</a>
		</nav>
	</section>

	<section class="mt-10" aria-label="知识库统计">
		<div class="stat-grid">
			<a class="stat-card no-underline" href="/posts/">
				<div class="stat-value">{allPosts.length}</div>
				<div class="stat-label">篇文章</div>
			</a>
			<a class="stat-card no-underline" href="/series/">
				<div class="stat-value">{seriesRows.length}</div>
				<div class="stat-label">条阅读路径</div>
			</a>
			<a class="stat-card no-underline" href="/categories/">
				<div class="stat-value">{categoryRows.length}</div>
				<div class="stat-label">个主题分类</div>
			</a>
			<a class="stat-card no-underline" href="/notes/">
				<div class="stat-value">{allNotes.length}</div>
				<div class="stat-label">篇笔记</div>
			</a>
		</div>
	</section>

	<div class="layout-with-rail mt-12">
		<div class="min-w-0 space-y-14">
			<section id="learning-paths" class="scroll-mt-24">
				<div class="section-label">Learning Paths</div>
				<div class="mb-5 flex items-end justify-between gap-3">
					<div>
						<h2 class="title text-xl">按系列学习</h2>
						<p class="mt-1 text-sm text-[var(--color-muted)]">系列内的文章与笔记已按建议阅读顺序排列。</p>
					</div>
					<a class="shrink-0 text-sm text-[var(--color-accent)] hover:underline" href="/series/">
						系列页 →
					</a>
				</div>

				<div class="space-y-5">
					{
						seriesRows.map((row) => (
							<article class="panel p-4 sm:p-5">
								<div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
									<div>
										<a
											class="text-lg font-semibold text-[var(--color-accent-2)] hover:text-[var(--color-accent)]"
											href={seriesPath(row.id)}
										>
											{row.title}
										</a>
										{row.description && (
											<p class="mt-1 max-w-3xl text-sm text-[var(--color-muted)]">
												{row.description}
											</p>
										)}
									</div>
									<span class="font-mono text-xs text-[var(--color-muted)]">{row.count} 篇</span>
								</div>
								<ol class="mt-4 grid gap-2 sm:grid-cols-2" role="list">
									{row.posts.map((post, index) => (
										<li>
											<a
												class="panel-soft flex h-full items-start gap-3 px-3 py-2.5 no-underline hover:border-[var(--color-accent)]"
												href={contentPath(post)}
											>
												<span class="mt-0.5 shrink-0 font-mono text-xs text-[var(--color-accent)]">
													{String(index + 1).padStart(2, "0")}
												</span>
												<span class="text-sm leading-snug text-[var(--color-text)]">
													{post.data.title}
												</span>
											</a>
										</li>
									))}
								</ol>
							</article>
						))
					}
				</div>
			</section>

			<section id="categories" class="scroll-mt-24">
				<div class="section-label">Topics</div>
				<div class="mb-5 flex items-end justify-between gap-3">
					<div>
						<h2 class="title text-xl">按主题浏览</h2>
						<p class="mt-1 text-sm text-[var(--color-muted)]">
							文章与笔记各归入一个一级主题，按用途和主题分别组织。
						</p>
					</div>
					<a
						class="shrink-0 text-sm text-[var(--color-accent)] hover:underline"
						href="/categories/"
					>
						分类页 →
					</a>
				</div>
				<ul class="grid gap-3 sm:grid-cols-2" role="list">
					{
						categoryRows.map((row) => (
							<li>
								<a class="post-card h-full" href={categoryPath(row.id)}>
									<div class="flex items-start justify-between gap-3">
										<span class="font-semibold text-[var(--color-accent-2)]">{row.title}</span>
										<span class="font-mono text-xs text-[var(--color-muted)]">{row.count} 篇</span>
									</div>
									{row.description && (
										<p class="mt-2 text-sm text-[var(--color-muted)]">{row.description}</p>
									)}
								</a>
							</li>
						))
					}
				</ul>
			</section>

			<section id="standalone" class="scroll-mt-24">
				<div class="section-label">Articles</div>
				<div class="mb-5 flex items-end justify-between gap-3">
					<div>
						<h2 class="title text-xl">文章</h2>
						<p class="mt-1 text-sm text-[var(--color-muted)]">
							知识库介绍、独立的方法论与经过整理的完整总结。
						</p>
					</div>
					<a class="shrink-0 text-sm text-[var(--color-accent)] hover:underline" href="/posts/">
						全部文章 →
					</a>
				</div>
				{
					sortedPosts.length > 0 ? (
						<ul class="space-y-3" role="list">
							{sortedPosts.map((post) => (
								<li class="panel-soft px-4 py-3">
									<PostPreview post={post} withDesc />
								</li>
							))}
						</ul>
					) : (
						<p class="text-sm text-[var(--color-muted)]">暂无文章。</p>
					)
				}
			</section>

			<section id="notes" class="scroll-mt-24">
				<div class="section-label">Notes</div>
				<div class="mb-5 flex items-end justify-between gap-3">
					<div>
						<h2 class="title text-xl">独立笔记</h2>
						<p class="mt-1 text-sm text-[var(--color-muted)]">
							不属于系列的读书记录、命令与流程。课程和专题笔记见上方阅读路径。
						</p>
					</div>
					<a class="shrink-0 text-sm text-[var(--color-accent)] hover:underline" href="/notes/">
						笔记页 →
					</a>
				</div>
				<ul class="space-y-4" role="list">
					{
						standaloneNotes.map((note) => (
							<li>
								<PostPreview post={note} as="h3" variant="card" withDesc />
							</li>
						))
					}
				</ul>
			</section>

			<section id="tags" class="scroll-mt-24">
				<div class="section-label">Cross Reference</div>
				<div class="mb-5 flex items-end justify-between gap-3">
					<div>
						<h2 class="title text-xl">热门标签</h2>
						<p class="mt-1 text-sm text-[var(--color-muted)]">
							用于跨分类连接方法、技术和研究主题。
						</p>
					</div>
					<a class="shrink-0 text-sm text-[var(--color-accent)] hover:underline" href="/tags/">
						全部标签 →
					</a>
				</div>
				<ul class="flex flex-wrap gap-2" role="list">
					{
						popularTags.map(([tag, count]) => (
							<li>
								<a class="chip" href={`/tags/${encodeURIComponent(tag)}/`}>
									#{tag}
									<span class="font-mono opacity-60">{count}</span>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</div>

		<aside class="layout-rail space-y-4" aria-label="知识索引说明">
			<div class="panel p-4">
				<div class="section-label">Index Guide</div>
				<h2 class="title mb-3 text-sm">索引口径</h2>
				<ul class="space-y-2 text-sm text-[var(--color-muted)]">
					<li><strong class="text-[var(--color-text)]">系列</strong>：按顺序系统学习</li>
					<li><strong class="text-[var(--color-text)]">分类</strong>：定位一级主题</li>
					<li><strong class="text-[var(--color-text)]">标签</strong>：跨主题查找概念</li>
					<li><strong class="text-[var(--color-text)]">归档</strong>：按时间回顾内容</li>
				</ul>
			</div>
			<div class="panel p-4">
				<div class="section-label">Source</div>
				<h2 class="title mb-2 text-sm">索引数据来源</h2>
				<p class="text-sm leading-relaxed text-[var(--color-muted)]">
					本页直接读取内容目录中的元数据，新增文章或笔记后会自动更新，不需要手工维护数量。
				</p>
				<a
					class="mt-3 inline-block text-xs text-[var(--color-accent)] hover:underline"
					href="/archives/"
				>
					查看时间归档 →
				</a>
			</div>
		</aside>
	</div>
</PageLayout>
