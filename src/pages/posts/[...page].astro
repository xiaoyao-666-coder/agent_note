---
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import { Icon } from "astro-icon/components";
import PostPreview from "@/components/blog/PostPreview.astro";
import Sidebar from "@/components/layout/Sidebar.astro";
import Pagination from "@/components/Paginator.astro";
import { getAllPosts, groupPostsByYear } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

export const getStaticPaths = (async ({ paginate }) => {
	const MAX_POSTS_PER_PAGE = 10;
	const MAX_PINNED_POSTS = 3;
	const allPosts = await getAllPosts();
	const allPostsByDate = allPosts.sort(collectionDateSort);
	const pinnedPosts = allPostsByDate.filter((p) => p.data.pinned).slice(0, MAX_PINNED_POSTS);
	return paginate(allPostsByDate, {
		pageSize: MAX_POSTS_PER_PAGE,
		props: { pinnedPosts },
	});
}) satisfies GetStaticPaths;

interface Props {
	page: Page<CollectionEntry<"post">>;
	pinnedPosts: CollectionEntry<"post">[];
}

const { page, pinnedPosts } = Astro.props;

const meta = {
	description: "完整的技术实践、项目复盘与知识整理文章。",
	title: "文章",
};

const paginationProps = {
	...(page.url.prev && {
		prevUrl: {
			text: "← 上一页",
			url: page.url.prev,
		},
	}),
	...(page.url.next && {
		nextUrl: {
			text: "下一页 →",
			url: page.url.next,
		},
	}),
};

const groupedByYear = groupPostsByYear(page.data);
const descYearKeys = Object.keys(groupedByYear).sort((a, b) => +b - +a);
---

<PageLayout meta={meta}>
	<div class="mb-8 flex flex-wrap items-center gap-3">
		<div>
			<div class="section-label">Posts</div>
			<h1 class="title">文章</h1>
		</div>
		<a
			class="ms-auto inline-flex items-center gap-1 rounded-md border border-[var(--color-border)] px-2 py-1 text-[var(--color-muted)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
			href="/rss.xml"
			target="_blank"
		>
			<span class="sr-only">文章 RSS 订阅</span>
			<Icon aria-hidden="true" class="h-5 w-5" focusable="false" name="mdi:rss" />
			<span class="text-xs font-mono">RSS</span>
		</a>
	</div>
	<p class="mb-8 max-w-2xl text-[var(--color-muted)]">
		完整教程、项目复盘与经过整理的技术总结。可按
		<a class="cactus-link" href="/categories/">分类</a>、
		<a class="cactus-link" href="/series/">系列</a>、
		<a class="cactus-link" href="/tags/">标签</a> 或
		<a class="cactus-link" href="/archives/">时间</a> 浏览。
	</p>
	<div class="layout-with-rail">
		<div class="min-w-0">
			{
				pinnedPosts.length > 0 && page.currentPage === 1 && (
					<section class="mb-12">
						<div class="section-label">Pinned</div>
						<h2 class="title mb-4 text-lg">精选</h2>
						<ul class="space-y-3" role="list">
							{pinnedPosts.map((p) => (
								<li>
									<PostPreview post={p} variant="card" withDesc />
								</li>
							))}
						</ul>
					</section>
				)
			}
			{
				descYearKeys.map((yearKey) => (
					<section class="mb-12">
						<h2 id={`year-${yearKey}`} class="archive-year">
							<span class="sr-only">发布年份：</span>
							{yearKey}
						</h2>
						<ul class="mt-4 space-y-3" role="list">
							{groupedByYear[yearKey]?.map((p) => (
								<li class="panel-soft px-4 py-3">
									<PostPreview post={p} withDesc />
								</li>
							))}
						</ul>
					</section>
				))
			}
			<Pagination {...paginationProps} />
		</div>
		<Sidebar />
	</div>
</PageLayout>
