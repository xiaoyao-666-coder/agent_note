---
import { type CollectionEntry, getCollection } from "astro:content";
import PostPreview from "@/components/blog/PostPreview.astro";
import Sidebar from "@/components/layout/Sidebar.astro";
import Note from "@/components/note/Note.astro";
import SocialList from "@/components/SocialList.astro";
import {
	categoryPath,
	getAllPosts,
	getPostsInSeries,
	getSeriesWithCount,
	getUniqueCategoriesWithCount,
	getUniqueTagsWithCount,
	seriesPath,
} from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

const MAX_POSTS = 6;
const MAX_NOTES = 4;
const allPosts = await getAllPosts();
const allPostsByDate = allPosts.sort(collectionDateSort) as CollectionEntry<"post">[];
const latestPosts = allPostsByDate.slice(0, MAX_POSTS);

const pinnedPosts = allPostsByDate.filter((p) => p.data.pinned).slice(0, 3);

const allNotes = await getCollection("note");
const latestNotes = allNotes
	.sort(collectionDateSort)
	.slice(0, MAX_NOTES) as CollectionEntry<"note">[];

const categories = getUniqueCategoriesWithCount(allPosts);
const allTagCounts = getUniqueTagsWithCount(allPosts);
const tags = allTagCounts.slice(0, 12);
const categoryMeta = await getCollection("category");
const categoryOrder = new Map(categoryMeta.map((c) => [c.id, c.data.order ?? 99]));
const sortedCategories = [...categories].sort((a, b) => {
	const oa = categoryOrder.get(a[0]) ?? 99;
	const ob = categoryOrder.get(b[0]) ?? 99;
	return oa - ob || a[0].localeCompare(b[0], "zh-CN");
});

const seriesMeta = await getCollection("series");
const seriesCounts = getSeriesWithCount(allPosts);
const seriesRows = seriesCounts
	.map(([id, count]) => {
		const meta = seriesMeta.find((s) => s.id === id);
		const posts = getPostsInSeries(id, allPosts);
		return {
			id,
			title: meta?.data.title ?? id,
			description: meta?.data.description ?? "",
			count,
			order: meta?.data.order ?? 99,
			firstId: posts[0]?.id,
		};
	})
	.sort((a, b) => a.order - b.order)
	.slice(0, 4);
---

<PageLayout meta={{ title: "首页" }}>
	<section class="hero-panel relative z-0">
		<div class="section-label">Personal Knowledge Base</div>
		<h1 class="title relative z-[1] text-2xl sm:text-3xl">逍遥哥的知识库</h1>
		<p class="relative z-[1] mt-3 max-w-2xl leading-relaxed text-[var(--color-muted)]">
			围绕人工智能、工程实践、知识管理与建站持续整理。知识索引汇总阅读路径与主题入口，文章沉淀完整结论，笔记保留可快速查找的命令和阶段记录。
		</p>
		<div class="relative z-[1] mt-5 flex flex-wrap gap-2">
			<a class="chip chip-accent" href="/knowledge/">打开知识索引</a>
			<a class="chip" href="/series/">系列目录</a>
			<a class="chip" href="/posts/">全部文章</a>
			<a class="chip" href="/archives/">时间归档</a>
		</div>
		<SocialList />
	</section>

	<section class="mt-10">
		<div class="stat-grid">
			<a class="stat-card no-underline" href="/posts/">
				<div class="stat-value">{allPosts.length}</div>
				<div class="stat-label">篇文章</div>
			</a>
			<a class="stat-card no-underline" href="/notes/">
				<div class="stat-value">{allNotes.length}</div>
				<div class="stat-label">条笔记</div>
			</a>
			<a class="stat-card no-underline" href="/series/">
				<div class="stat-value">{seriesCounts.length}</div>
				<div class="stat-label">个系列</div>
			</a>
			<a class="stat-card no-underline" href="/categories/">
				<div class="stat-value">{categories.length}</div>
				<div class="stat-label">个分类</div>
			</a>
		</div>
	</section>

	<div class="layout-with-rail mt-12">
		<div class="min-w-0 space-y-12">
			{
				seriesRows.length > 0 && (
					<section>
						<div class="section-label">Series</div>
						<div class="mb-4 flex items-end justify-between gap-3">
							<h2 class="title text-xl">学习路径</h2>
							<a class="text-sm text-[var(--color-accent)] hover:underline" href="/series/">
								全部系列 →
							</a>
						</div>
						<ul class="grid gap-3 sm:grid-cols-2" role="list">
							{seriesRows.map((row) => (
								<li>
									<a class="post-card h-full" href={seriesPath(row.id)}>
										<span class="font-semibold text-[var(--color-accent-2)]">{row.title}</span>
										{row.description && (
											<p class="mt-1 line-clamp-2 text-xs text-[var(--color-muted)]">
												{row.description}
											</p>
										)}
										<span class="meta-row mt-3 font-mono text-xs">{row.count} 篇 · 按序阅读</span>
									</a>
								</li>
							))}
						</ul>
					</section>
				)
			}

			{
				sortedCategories.length > 0 && (
					<section>
						<div class="section-label">Taxonomy</div>
						<div class="mb-4 flex items-end justify-between gap-3">
							<h2 class="title text-xl">内容分类</h2>
							<a class="text-sm text-[var(--color-accent)] hover:underline" href="/categories/">
								全部 →
							</a>
						</div>
						<ul class="grid gap-3 sm:grid-cols-3" role="list">
							{sortedCategories.map(([name, count]) => {
								const meta = categoryMeta.find((c) => c.id === name);
								return (
									<li>
										<a class="post-card h-full" href={categoryPath(name)}>
											<span class="font-semibold text-[var(--color-accent-2)]">
												{meta?.data.title ?? name}
											</span>
											<p class="mt-1 line-clamp-2 text-xs text-[var(--color-muted)]">
												{meta?.data.description ?? `${count} 篇文章`}
											</p>
											<span class="meta-row mt-3 font-mono text-xs">{count} 篇</span>
										</a>
									</li>
								);
							})}
						</ul>
					</section>
				)
			}

			{
				pinnedPosts.length > 0 && (
					<section>
						<div class="section-label">Pinned</div>
						<h2 class="title mb-4 text-xl">精选文章</h2>
						<ul class="grid gap-3" role="list">
							{pinnedPosts.map((p) => (
								<li>
									<PostPreview post={p} variant="card" withDesc />
								</li>
							))}
						</ul>
					</section>
				)
			}

			<section>
				<div class="section-label">Latest</div>
				<div class="mb-4 flex items-end justify-between gap-3">
					<h2 class="title text-xl">最新文章</h2>
					<a class="text-sm text-[var(--color-accent)] hover:underline" href="/posts/">全部文章 →</a
					>
				</div>
				<ul class="space-y-4" role="list">
					{
						latestPosts.map((p) => (
							<li class="panel-soft px-4 py-3">
								<PostPreview post={p} withDesc />
							</li>
						))
					}
				</ul>
			</section>

			{
				latestNotes.length > 0 && (
					<section>
						<div class="section-label">Notes</div>
						<div class="mb-4 flex items-end justify-between gap-3">
							<h2 class="title text-xl">最近笔记</h2>
							<a class="text-sm text-[var(--color-accent)] hover:underline" href="/notes/">
								全部笔记 →
							</a>
						</div>
						<ul class="space-y-4" role="list">
							{latestNotes.map((note) => (
								<li>
									<Note note={note} as="h3" isPreview />
								</li>
							))}
						</ul>
					</section>
				)
			}

			{
				tags.length > 0 && (
					<section class="mb-2 lg:hidden">
						<div class="section-label">Tags</div>
						<div class="mb-4 flex items-end justify-between gap-3">
							<h2 class="title text-xl">热门标签</h2>
							<a class="text-sm text-[var(--color-accent)] hover:underline" href="/tags/">
								全部标签 →
							</a>
						</div>
						<div class="flex flex-wrap gap-2">
							{tags.map(([tag, count]) => (
								<a class="chip" href={`/tags/${tag}/`}>
									#{tag}
									<span class="opacity-60">{count}</span>
								</a>
							))}
						</div>
					</section>
				)
			}
		</div>
		<Sidebar />
	</div>
</PageLayout>
