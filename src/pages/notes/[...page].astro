---
import { type CollectionEntry, getCollection } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import { Icon } from "astro-icon/components";
import PostPreview from "@/components/blog/PostPreview.astro";
import Pagination from "@/components/Paginator.astro";
import { getAllNotes, getPostsInSeries, seriesPath } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

export const getStaticPaths = (async ({ paginate }) => {
	const MAX_NOTES_PER_PAGE = 10;
	const allNotes = await getAllNotes();
	return paginate(allNotes.sort(collectionDateSort), { pageSize: MAX_NOTES_PER_PAGE });
}) satisfies GetStaticPaths;

interface Props {
	page: Page<CollectionEntry<"note">>;
}

const { page } = Astro.props;
const allNotes = await getAllNotes();
const noteSeries = (await getCollection("series"))
	.map((series) => ({ ...series, count: getPostsInSeries(series.id, allNotes).length }))
	.filter((series) => series.count > 0)
	.sort((a, b) => a.data.order - b.data.order);

const meta = {
	description: "按专题整理课程学习、读书笔记、操作清单与命令速查，长篇笔记也可以按目录和系列阅读。",
	title: "笔记",
};

const paginationProps = {
	...(page.url.prev && {
		prevUrl: {
			text: "← 上一页",
			url: page.url.prev,
		},
	}),
	...(page.url.next && {
		nextUrl: {
			text: "下一页 →",
			url: page.url.next,
		},
	}),
};
---

<PageLayout meta={meta}>
	<section>
		<div class="mb-4 flex flex-wrap items-center gap-3">
			<div>
				<div class="section-label">Notes</div>
				<h1 class="title">笔记</h1>
			</div>
			<a
				class="ms-auto inline-flex items-center gap-1 rounded-md border border-[var(--color-border)] px-2 py-1 text-[var(--color-muted)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
				href="/notes/rss.xml"
				target="_blank"
			>
				<span class="sr-only">笔记 RSS 订阅</span>
				<Icon aria-hidden="true" class="h-5 w-5" focusable="false" name="mdi:rss" />
				<span class="text-xs font-mono">RSS</span>
			</a>
		</div>
		<p class="mb-8 text-[var(--color-muted)]">
			课程与读书笔记、操作清单、命令速查都收录在这里，按用途区分，不以篇幅长短划分。独立的方法总结请看
			<a class="cactus-link" href="/posts/">文章</a>。
		</p>
		{
			page.currentPage === 1 && noteSeries.length > 0 && (
				<section class="mb-10" aria-label="专题笔记">
					<h2 class="title mb-4 text-lg">按专题阅读</h2>
					<ul class="grid gap-3 sm:grid-cols-2" role="list">
						{noteSeries.map((series) => (
							<li>
								<a class="post-card h-full" href={seriesPath(series.id)}>
									<span class="font-semibold text-[var(--color-accent-2)]">{series.data.title}</span>
									<p class="mt-2 text-sm text-[var(--color-muted)]">{series.data.description}</p>
									<span class="meta-row mt-3">{series.count} 篇笔记 · 按序阅读 →</span>
								</a>
							</li>
						))}
					</ul>
				</section>
			)
		}
		<h2 class="title mb-4 text-lg">全部笔记 <span class="text-sm font-normal text-[var(--color-muted)]">（{page.total} 篇）</span></h2>
		<ul class="space-y-4 text-start" role="list">
			{
				page.data.map((note) => (
					<li>
						<PostPreview post={note} as="h3" variant="card" withDesc />
					</li>
				))
			}
		</ul>
		<Pagination {...paginationProps} />
	</section>
</PageLayout>
