---
import { type CollectionEntry, render } from "astro:content";
import type { HTMLTag, Polymorphic } from "astro/types";
import FormattedDate from "@/components/FormattedDate.astro";
import { categoryPath } from "@/data/post";

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
	note: CollectionEntry<"note">;
	isPreview?: boolean | undefined;
};

const { as: Tag = "div", note, isPreview = false } = Astro.props;
const { Content } = await render(note);
const { data } = note;
---

<article
	class:list={[
		isPreview && "panel-soft px-4 py-3",
		!isPreview && "panel px-5 py-5 sm:px-6",
	]}
	data-pagefind-body={isPreview ? false : true}
>
	<div class="meta-row mb-2">
		{
			data.category && (
				<a class="chip chip-accent" href={categoryPath(data.category)}>
					{data.category}
				</a>
			)
		}
		<span class="chip">笔记</span>
		<FormattedDate
			class="font-mono text-xs"
			dateTimeOptions={{
				hour: "2-digit",
				minute: "2-digit",
				year: "2-digit",
				month: "2-digit",
				day: "2-digit",
			}}
			date={data.publishDate}
		/>
	</div>
	<Tag class="title" class:list={{ "text-base": isPreview, "text-xl": !isPreview }}>
		{
			isPreview ? (
				<a class="cactus-link no-underline hover:underline" href={`/notes/${note.id}/`}>
					{data.title}
				</a>
			) : (
				<>{data.title}</>
			)
		}
	</Tag>
	{
		!!data.tags?.length && (
			<div class="mt-2 flex flex-wrap gap-1.5">
				{data.tags.map((tag: string) => (
					<span class="chip">#{tag}</span>
				))}
			</div>
		)
	}
	<div
		class="prose prose-sm prose-cactus mt-3 max-w-none [&>p:last-of-type]:mb-0"
		class:list={{ "line-clamp-5": isPreview }}
	>
		<Content />
	</div>
</article>
