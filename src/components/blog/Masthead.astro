---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import FormattedDate from "@/components/FormattedDate.astro";
import { categoryPath, getSeriesMeta, seriesPath } from "@/data/post";

interface Props {
	content: CollectionEntry<"post">;
	readingTime: string;
}

const {
	content: { data },
	readingTime,
} = Astro.props;

const seriesMeta = data.series ? await getSeriesMeta(data.series) : undefined;
---

{
	data.coverImage && (
		<div class="mb-6 overflow-hidden rounded-xl border border-[var(--color-border)] aspect-video">
			<Image
				alt={data.coverImage.alt}
				layout="constrained"
				width={748}
				height={420}
				priority
				src={data.coverImage.src}
			/>
		</div>
	)
}
<div class="meta-row mb-3">
	<a class="chip chip-accent" href={categoryPath(data.category)} data-pagefind-filter={`category:${data.category}`}>
		{data.category}
	</a>
	{
		seriesMeta && data.series && (
			<a class="chip" href={seriesPath(data.series)} data-pagefind-filter={`series:${data.series}`}>
				系列 · {seriesMeta.data.title}
				{data.seriesOrder != null ? ` · #${data.seriesOrder}` : ""}
			</a>
		)
	}
	{data.draft ? <span class="text-sm text-red-500">草稿</span> : null}
</div>
<h1 class="title text-2xl sm:text-3xl">
	{data.title}
</h1>
{
	data.description && (
		<p class="mt-3 max-w-3xl text-[var(--color-muted)] leading-relaxed">{data.description}</p>
	)
}
<div class="meta-row mt-4 font-mono text-xs">
	<span>
		<FormattedDate date={data.publishDate} />
	</span>
	<span aria-hidden="true" class="text-[var(--color-border)]">/</span>
	<span>{readingTime.replace("min read", "分钟阅读")}</span>
	{
		data.updatedDate && (
			<>
				<span aria-hidden="true" class="text-[var(--color-border)]">
					/
				</span>
				<span class="chip">
					更新
					<FormattedDate class="ms-1" date={data.updatedDate} />
				</span>
			</>
		)
	}
</div>
{
	!!data.tags?.length && (
		<div class="mt-4 flex flex-wrap gap-1.5">
			{data.tags.map((tag) => (
				<a class="chip" data-pagefind-filter={`tag:${tag}`} href={`/tags/${tag}/`}>
					<span class="sr-only">查看更多带有此标签的文章：</span>#{tag}
				</a>
			))}
		</div>
	)
}
