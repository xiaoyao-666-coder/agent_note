---
import type { CollectionEntry } from "astro:content";
import type { HTMLTag, Polymorphic } from "astro/types";
import FormattedDate from "@/components/FormattedDate.astro";
import { categoryPath } from "@/data/post";

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
	post: CollectionEntry<"post">;
	withDesc?: boolean;
	/** card style for home / related lists */
	variant?: "row" | "card";
};

const { as: Tag = "div", post, withDesc = false, variant = "row" } = Astro.props;
const { data } = post;
---

{
	variant === "card" ? (
		<a class="post-card" href={`/posts/${post.id}/`}>
			<div class="meta-row mb-2">
				<span class="chip chip-accent">{data.category}</span>
				{data.series && <span class="chip">系列</span>}
				<FormattedDate date={data.publishDate} />
				{data.draft && <span class="text-red-500">草稿</span>}
			</div>
			<Tag class="text-base font-semibold text-[var(--color-accent-2)]">{data.title}</Tag>
			{withDesc && data.description && (
				<p class="mt-2 line-clamp-2 text-sm text-[var(--color-muted)]">{data.description}</p>
			)}
			{!!data.tags?.length && (
				<div class="mt-3 flex flex-wrap gap-1.5">
					{data.tags.slice(0, 4).map((tag: string) => (
						<span class="chip">#{tag}</span>
					))}
				</div>
			)}
		</a>
	) : (
		<div class="grid gap-1 sm:grid-cols-[auto_1fr] sm:items-baseline sm:gap-x-4">
			<FormattedDate class="font-mono text-xs font-medium text-[var(--color-muted)]" date={data.publishDate} />
			<div class="min-w-0">
				<div class="flex flex-wrap items-center gap-2">
					<a class="chip chip-accent" href={categoryPath(data.category)}>
						{data.category}
					</a>
					{data.draft && <span class="text-xs text-red-500">草稿</span>}
				</div>
				<Tag class="mt-1 block">
					<a class="cactus-link text-base font-medium text-[var(--color-accent-2)] no-underline hover:underline" href={`/posts/${post.id}/`}>
						{data.title}
					</a>
				</Tag>
				{withDesc && data.description && (
					<p class="mt-1 line-clamp-2 text-sm text-[var(--color-muted)]">{data.description}</p>
				)}
			</div>
		</div>
	)
}
