---
import PostPreview from "@/components/blog/PostPreview.astro";
import { type ContentEntry, contentPath } from "@/data/post";

interface Props {
	posts: ContentEntry[];
	prev?: ContentEntry | undefined;
	next?: ContentEntry | undefined;
}

const { posts, prev, next } = Astro.props;
---

{
	(posts.length > 0 || prev || next) && (
		<section class="mt-14 border-t border-[var(--color-border)] pt-10" data-pagefind-ignore>
			{(prev || next) && (
				<nav aria-label="上一篇与下一篇" class="mb-10 grid gap-3 sm:grid-cols-2">
					{prev ? (
						<a class="post-card" href={contentPath(prev)}>
							<span class="section-label mb-1">上一篇</span>
							<span class="block font-medium text-[var(--color-accent-2)]">{prev.data.title}</span>
						</a>
					) : (
						<div />
					)}
					{next ? (
						<a class="post-card text-end sm:text-end" href={contentPath(next)}>
							<span class="section-label mb-1 sm:justify-end">下一篇</span>
							<span class="block font-medium text-[var(--color-accent-2)]">{next.data.title}</span>
						</a>
					) : null}
				</nav>
			)}
			{posts.length > 0 && (
				<>
					<div class="section-label">相关内容</div>
					<h2 class="title mb-4 text-lg">你可能还想看</h2>
					<ul class="grid gap-3 sm:grid-cols-1" role="list">
						{posts.map((post) => (
							<li>
								<PostPreview post={post} variant="card" withDesc />
							</li>
						))}
					</ul>
				</>
			)}
		</section>
	)
}
