---
import type { CollectionEntry } from "astro:content";
import { type ContentEntry, contentPath, seriesPath } from "@/data/post";

interface Props {
	seriesMeta: CollectionEntry<"series">;
	posts: ContentEntry[];
	currentPath?: string;
	/** compact for article rail */
	compact?: boolean;
}

const { seriesMeta, posts, currentPath, compact = false } = Astro.props;
const total = posts.length;
const currentIndex = currentPath ? posts.findIndex((p) => contentPath(p) === currentPath) : -1;
---

<aside class:list={["panel", compact ? "p-3" : "p-4", "series-nav"]} data-pagefind-ignore>
	<div class="section-label mb-1">Series</div>
	<a
		class="mb-1 block text-sm font-semibold text-[var(--color-accent-2)] no-underline hover:text-[var(--color-accent)]"
		href={seriesPath(seriesMeta.id)}
	>
		{seriesMeta.data.title}
	</a>
	{
		!compact && seriesMeta.data.description && (
			<p class="mb-3 text-xs text-[var(--color-muted)]">{seriesMeta.data.description}</p>
		)
	}
	<p class="mb-3 font-mono text-[0.65rem] text-[var(--color-muted)]">
		{currentIndex >= 0 ? `${currentIndex + 1} / ${total}` : `${total} 篇`}
	</p>
	<ol>
		{
			posts.map((post) => {
				const isCurrent = contentPath(post) === currentPath;
				return (
					<li data-current={isCurrent ? "true" : "false"}>
						{isCurrent ? (
							<span aria-current="page">{post.data.title}</span>
						) : (
							<a href={contentPath(post)}>{post.data.title}</a>
						)}
					</li>
				);
			})
		}
	</ol>
</aside>
