---
import type { PaginationLink } from "@/types";

interface Props {
	nextUrl?: PaginationLink;
	prevUrl?: PaginationLink;
}

const { nextUrl, prevUrl } = Astro.props;
---

{
	(prevUrl || nextUrl) && (
		<nav class="mt-10 flex items-center gap-3 border-t border-[var(--color-border)] pt-6">
			{prevUrl && (
				<a class="chip chip-accent me-auto" href={prevUrl.url}>
					{prevUrl.srLabel && <span class="sr-only">{prevUrl.srLabel}</span>}
					{prevUrl.text ? prevUrl.text : "上一页"}
				</a>
			)}
			{nextUrl && (
				<a class="chip chip-accent ms-auto" href={nextUrl.url}>
					{nextUrl.srLabel && <span class="sr-only">{nextUrl.srLabel}</span>}
					{nextUrl.text ? nextUrl.text : "下一页"}
				</a>
			)}
		</nav>
	)
}
