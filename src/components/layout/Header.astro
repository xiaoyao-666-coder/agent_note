---
import Search from "@/components/Search.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { getAllPosts } from "@/data/post";
import { menuLinks, siteConfig } from "@/site.config";

const hasPosts = (await getAllPosts()).length > 0;
const visibleMenuLinks = menuLinks.filter((link) => link.path !== "/posts/" || hasPosts);
const pathname = Astro.url.pathname;
function isActive(path: string) {
	if (path === "/") return pathname === "/";
	return pathname === path || pathname.startsWith(path);
}
---

<header class="site-header group relative flex items-center gap-2" id="main-header">
	<div class="flex min-w-0 flex-1 flex-col gap-1 sm:gap-1.5">
		<a
			aria-current={pathname === "/" ? "page" : false}
			class="inline-flex min-w-0 items-center gap-2.5 no-underline"
			href="/"
		>
			{
				siteConfig.showLogo && (
					<span
						aria-hidden="true"
						class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md border border-[var(--color-border)] bg-[color-mix(in_oklch,var(--color-accent)_12%,var(--color-surface))] font-mono text-xs font-bold text-[var(--color-accent)] shadow-[0_0_12px_color-mix(in_oklch,var(--color-accent)_20%,transparent)]"
					>
						XY
					</span>
				)
			}
			<span
				class="truncate text-base font-semibold tracking-tight text-[var(--color-accent-2)] sm:text-lg"
			>
				{siteConfig.title}
			</span>
		</a>
		<nav
			aria-label="主导航"
			class="absolute -inset-x-4 top-full z-50 hidden max-h-[70vh] flex-col gap-0.5 overflow-y-auto border border-[var(--color-border)] bg-[var(--color-surface)] p-2 shadow-lg group-[.menu-open]:flex sm:static sm:z-auto sm:mt-0 sm:flex sm:max-h-none sm:flex-row sm:flex-wrap sm:gap-0.5 sm:overflow-visible sm:border-0 sm:bg-transparent sm:p-0 sm:shadow-none"
			id="navigation-menu"
		>
			{
				visibleMenuLinks.map((link) => (
					<a aria-current={isActive(link.path) ? "page" : false} class="nav-link" href={link.path}>
						{link.title}
					</a>
				))
			}
		</nav>
	</div>
	<div class="ms-auto flex shrink-0 items-center gap-0.5">
		<Search />
		<ThemeToggle />
		<mobile-button>
			<button
				aria-expanded="false"
				aria-haspopup="menu"
				class="group relative ms-1 h-9 w-9 cursor-pointer p-1.5 hover:text-[var(--color-accent)] sm:invisible sm:hidden"
				id="toggle-navigation-menu"
				type="button"
			>
				<span class="sr-only">打开或关闭主导航</span>
				<svg
					aria-hidden="true"
					class="absolute start-1/2 top-1/2 h-6 w-6 -translate-x-1/2 -translate-y-1/2 transition-all group-aria-expanded:scale-0 group-aria-expanded:opacity-0"
					fill="none"
					focusable="false"
					stroke="currentColor"
					stroke-width="1.5"
					viewBox="0 0 24 24"
					xmlns="http://www.w3.org/2000/svg"
				>
					<path d="M3.75 9h16.5m-16.5 6.75h16.5" stroke-linecap="round" stroke-linejoin="round"
					></path>
				</svg>
				<svg
					aria-hidden="true"
					class="absolute start-1/2 top-1/2 h-6 w-6 -translate-x-1/2 -translate-y-1/2 scale-0 text-[var(--color-accent)] opacity-0 transition-all group-aria-expanded:scale-100 group-aria-expanded:opacity-100"
					fill="none"
					focusable="false"
					stroke="currentColor"
					stroke-width="1.5"
					viewBox="0 0 24 24"
					xmlns="http://www.w3.org/2000/svg"
				>
					<path d="M6 18L18 6M6 6l12 12" stroke-linecap="round" stroke-linejoin="round"></path>
				</svg>
			</button>
		</mobile-button>
	</div>
</header>

<script>
	import { toggleClass } from "@/utils/domElement";

	class MobileNavBtn extends HTMLElement {
		#menuOpen: boolean = false;

		connectedCallback() {
			const headerEl = document.getElementById("main-header")!;
			const mobileButtonEl = this.querySelector<HTMLButtonElement>("button");

			mobileButtonEl?.addEventListener("click", () => {
				if (headerEl) toggleClass(headerEl, "menu-open");
				this.#menuOpen = !this.#menuOpen;
				mobileButtonEl.setAttribute("aria-expanded", this.#menuOpen.toString());
			});
		}
	}

	customElements.define("mobile-button", MobileNavBtn);
</script>
