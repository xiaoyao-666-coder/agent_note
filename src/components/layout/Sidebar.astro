---
import { getCollection } from "astro:content";
import {
	categoryPath,
	getAllContent,
	getSeriesWithCount,
	getUniqueCategoriesWithCount,
	getUniqueTagsWithCount,
	seriesPath,
} from "@/data/post";

const allPosts = await getAllContent();
const categories = getUniqueCategoriesWithCount(allPosts).slice(0, 8);
const tags = getUniqueTagsWithCount(allPosts).slice(0, 12);
const seriesCounts = getSeriesWithCount(allPosts);
const seriesMeta = await getCollection("series");
const seriesRows = seriesCounts
	.map(([id, count]) => {
		const meta = seriesMeta.find((s) => s.id === id);
		return {
			id,
			title: meta?.data.title ?? id,
			count,
			order: meta?.data.order ?? 99,
		};
	})
	.sort((a, b) => a.order - b.order || a.title.localeCompare(b.title, "zh-CN"));
---

<div class="layout-rail space-y-4">
	{
		categories.length > 0 && (
			<div class="panel p-4">
				<div class="section-label">Browse</div>
				<h2 class="title mb-3 text-sm">分类</h2>
				<ul class="space-y-2">
					{categories.map(([cat, count]) => (
						<li class="flex items-center justify-between gap-2 text-sm">
							<a class="cactus-link no-underline hover:underline" href={categoryPath(cat)}>
								{cat}
							</a>
							<span class="font-mono text-xs text-[var(--color-muted)]">{count}</span>
						</li>
					))}
				</ul>
				<a class="mt-3 inline-block text-xs text-[var(--color-accent)] hover:underline" href="/categories/">
					全部分类 →
				</a>
			</div>
		)
	}
	{
		seriesRows.length > 0 && (
			<div class="panel p-4">
				<div class="section-label">Series</div>
				<h2 class="title mb-3 text-sm">系列</h2>
				<ul class="space-y-2">
					{seriesRows.map((row) => (
						<li class="flex items-center justify-between gap-2 text-sm">
							<a class="cactus-link no-underline hover:underline" href={seriesPath(row.id)}>
								{row.title}
							</a>
							<span class="font-mono text-xs text-[var(--color-muted)]">{row.count}</span>
						</li>
					))}
				</ul>
				<a class="mt-3 inline-block text-xs text-[var(--color-accent)] hover:underline" href="/series/">
					全部系列 →
				</a>
			</div>
		)
	}
	{
		tags.length > 0 && (
			<div class="panel p-4">
				<div class="section-label">Tags</div>
				<h2 class="title mb-3 text-sm">标签</h2>
				<div class="flex flex-wrap gap-1.5">
					{tags.map(([tag, count]) => (
						<a class="chip" href={`/tags/${tag}/`}>
							#{tag}
							<span class="opacity-60">{count}</span>
						</a>
					))}
				</div>
				<a class="mt-3 inline-block text-xs text-[var(--color-accent)] hover:underline" href="/tags/">
					全部标签 →
				</a>
			</div>
		)
	}
	<div class="panel p-4">
		<div class="section-label">Quick</div>
		<div class="flex flex-wrap gap-1.5">
			<a class="chip" href="/archives/">归档</a>
			<a class="chip" href="/notes/">笔记</a>
			<a class="chip" href="/rss.xml">RSS</a>
			<a class="chip" href="/about/">关于</a>
		</div>
	</div>
</div>
